# ==============================================================================
# AGROSENSE CAFÉ - CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo a .env y reemplaza los valores "changeme" antes de ejecutar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUERTOS DE INGRESO (PUBLIC SUBNET)
# ------------------------------------------------------------------------------
API_PORT=8000
AIRFLOW_PORT=8080

# ------------------------------------------------------------------------------
# 2. POSTGRESQL + POSTGIS (SERVICIO: db)
# ------------------------------------------------------------------------------
POSTGRES_USER=agrosense_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agrosense_db
AIRFLOW_DB_NAME=airflow_db

# Driver asíncrono (asyncpg) consumido por FastAPI (pydantic-settings con prefijo AGROSENSE_)
AGROSENSE_DATABASE_URL=postgresql+asyncpg://agrosense_user:changeme@db:5432/agrosense_db

# Driver síncrono (psycopg v3) consumido por Alembic (apps/api/migrations/env.py)
DATABASE_URL=postgresql+psycopg://agrosense_user:changeme@db:5432/agrosense_db

# ------------------------------------------------------------------------------
# 3. RABBITMQ BROKER (SERVICIO: broker)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=agrosense_mq
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_DEFAULT_VHOST=/

# URL de conexión AMQP consumida por FastAPI y consumidores internos
AGROSENSE_RABBITMQ_URL=amqp://agrosense_mq:changeme@broker:5672/

# ------------------------------------------------------------------------------
# 4. SEGURIDAD Y CORS DE FASTAPI (PREFIJO AGROSENSE_)
# ------------------------------------------------------------------------------
AGROSENSE_JWT_SECRET_KEY=changeme
AGROSENSE_BUYER_JWT_SECRET_KEY=changeme
AGROSENSE_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# 5. APACHE AIRFLOW (LOCALEXECUTOR)
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@agrosense.local

# Generar Fernet Key real con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=changeme
AIRFLOW__WEBSERVER__SECRET_KEY=changeme

# ------------------------------------------------------------------------------
# 6. AMAZON WEB SERVICES - S3 DIRECTO (DATA LAKE / MEDALLION)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=agrosense-datalake-changeme
