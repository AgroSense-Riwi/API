# ==============================================================================
# AGROSENSE CAFÉ - CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo a .env y reemplaza los valores "changeme" antes de ejecutar.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUERTOS DE INGRESO (PUBLIC SUBNET)
# ------------------------------------------------------------------------------
API_PORT=8000
AIRFLOW_PORT=8080

# ------------------------------------------------------------------------------
# 2. POSTGRESQL + POSTGIS (SERVICIO: db)
# ------------------------------------------------------------------------------
POSTGRES_USER=agrosense_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agrosense_db
AIRFLOW_DB_NAME=airflow_db

# Rol de aplicación de la API (no dueño de las tablas, sin BYPASSRLS -> RLS efectivo, RN-11).
# Lo crea infra/docker/postgres/init/02-create-app-role.sh al inicializar el volumen.
AGROSENSE_APP_DB_PASSWORD=changeme

# Driver asíncrono (asyncpg) consumido por FastAPI con el rol agrosense_app
AGROSENSE_DATABASE_URL=postgresql+asyncpg://agrosense_app:changeme@db:5432/agrosense_db

# Driver síncrono (psycopg v3) consumido por Alembic (rol dueño; también lo usa el seed)
DATABASE_URL=postgresql+psycopg://agrosense_user:changeme@db:5432/agrosense_db

# ------------------------------------------------------------------------------
# 3. RABBITMQ BROKER (SERVICIO: broker)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=agrosense_mq
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_DEFAULT_VHOST=/agrosense
# Consola de administración: http://localhost:15672 (solo loopback)
RABBITMQ_MGMT_PORT=15672

# URL de conexión AMQP (vhost /agrosense codificado como %2Fagrosense) consumida por la API,
# el FastConsumer de telemetría y los simuladores
AGROSENSE_RABBITMQ_URL=amqp://agrosense_mq:changeme@broker:5672/%2Fagrosense

# ------------------------------------------------------------------------------
# 4. SEGURIDAD Y CORS DE FASTAPI (PREFIJO AGROSENSE_)
# ------------------------------------------------------------------------------
# SOLO DESARROLLO LOCAL: placeholders de >= 32 caracteres para que la API arranque con
# `cp .env.example .env`. Para cualquier entorno compartido genera valores reales con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGROSENSE_JWT_SECRET_KEY=changeme-dev-only-operator-jwt-secret-32+chars
AGROSENSE_BUYER_JWT_SECRET_KEY=changeme-dev-only-buyer-jwt-secret-32+chars
AGROSENSE_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Usuario bootstrap de /api/v1/auth/token (rol ADMIN). Los demás operadores se autentican
# contra la tabla users (email + password_hash). Genera el hash Argon2 con:
#   docker compose run --rm --no-deps --entrypoint python api -m agrosense_api.cli hash-secret
# y pégalo ENTRE COMILLAS SIMPLES (el hash contiene '$'):
#   AGROSENSE_AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# Con el placeholder 'changeme' la API arranca, pero el login bootstrap responde 401.
AGROSENSE_AUTH_USERNAME=admin@agrosense.local
AGROSENSE_AUTH_PASSWORD_HASH=changeme

# ------------------------------------------------------------------------------
# 5. APACHE AIRFLOW (LOCALEXECUTOR) - SimpleAuthManager con login real
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
# Usuario (rol admin) y contraseña de la UI de Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# SOLO DESARROLLO LOCAL: clave Fernet válida (32 bytes en base64 url-safe). Genera una real con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=changemechangemechangemechangemechangeme000=
AIRFLOW__WEBSERVER__SECRET_KEY=changeme-dev-only-airflow-api-secret-32+chars

# ------------------------------------------------------------------------------
# 6. AMAZON WEB SERVICES - S3 DIRECTO (DATA LAKE / MEDALLION) - Región us-east-2 (Ohio)
# ------------------------------------------------------------------------------
# Deja las credenciales SIN definir para usar la cadena por defecto de boto3 (perfil local,
# rol de la tarea ECS). Descomenta sólo con credenciales reales de desarrollo; nunca se
# envían valores de relleno a boto3.
# AWS_ACCESS_KEY_ID=changeme
# AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=agrosense-datalake-changeme

# ------------------------------------------------------------------------------
# 7. PARÁMETROS DE EJECUCIÓN Y GENERACIÓN DE SEMILLAS (CT-01, CT-06)
# ------------------------------------------------------------------------------
SEED_PROFILE=dev
SEED_ENABLED=false
SEED_VALUE=42
SEED_DEFECT_GLOBAL_RATE=0.05
SKIP_MIGRATIONS=false
