{
  "family": "agrosense-airflow",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/rol_1_ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/rol_2_agrosense-api-task-role",
  "containerDefinitions": [
    {
      "name": "airflow-standalone-scheduler",
      "image": "${AIRFLOW_IMAGE}",
      "essential": true,
      "entryPoint": [
        "/usr/bin/dumb-init",
        "--",
        "/bin/bash",
        "-c",
        "export AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=\"$(printenv AIRFLOW_ADMIN_USER):admin\" && python -c 'import json, os; path = os.environ[\"AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE\"]; fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600); os.write(fd, (json.dumps({os.environ[\"AIRFLOW_ADMIN_USER\"]: os.environ[\"AIRFLOW_ADMIN_PASSWORD\"]}) + \"\\n\").encode()); os.close(fd)' && exec /entrypoint \"$@\"",
        "--"
      ],
      "command": ["standalone"],
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AIRFLOW__CORE__EXECUTOR", "value": "LocalExecutor" },
        { "name": "AIRFLOW__CORE__LOAD_EXAMPLES", "value": "false" },
        { "name": "AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION", "value": "false" },
        { "name": "AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS", "value": "false" },
        {
          "name": "AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE",
          "value": "/tmp/simple_auth_manager_passwords.json"
        },
        { "name": "SPARK_MASTER", "value": "local[2]" },
        { "name": "S3_BUCKET_GOLD", "value": "datalakeagrosense" },
        { "name": "AWS_DEFAULT_REGION", "value": "${AWS_REGION}" }
      ],
      "secrets": [
        {
          "name": "AIRFLOW__DATABASE__SQL_ALCHEMY_CONN",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-database-url"
        },
        {
          "name": "AIRFLOW__CORE__FERNET_KEY",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-fernet-key"
        },
        {
          "name": "AIRFLOW__WEBSERVER__SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-api-secret"
        },
        {
          "name": "AIRFLOW__API__SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-api-secret"
        },
        {
          "name": "AIRFLOW__API_AUTH__JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-api-secret"
        },
        {
          "name": "AIRFLOW_ADMIN_USER",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-admin-user"
        },
        {
          "name": "AIRFLOW_ADMIN_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/airflow-admin-password"
        },
        {
          "name": "S3_BUCKET_BRONZE",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/s3-bucket-raw"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:agrosense/prod/database-url-sync"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agrosense-airflow",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "airflow"
        }
      }
    }
  ]
}
